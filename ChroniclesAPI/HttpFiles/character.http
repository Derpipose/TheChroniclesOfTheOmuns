# @baseUrl = http://derpserver.flyingfox-gourami.ts.net:5400
@baseUrl = http://localhost:5237
@token = derp 
@characterId = 2

### Get all characters (with stats)
GET {{baseUrl}}/api/character
Authorization: Bearer {{token}}

###

### Get all character details (no stats)
GET {{baseUrl}}/api/character/details
Authorization: Bearer {{token}}

### Get scifi character by character id
GET {{baseUrl}}/api/scifi/scificharacter/by-character/{{characterId}}
Authorization: Bearer {{token}}

### Get character by id (with stats)
GET {{baseUrl}}/api/character/1
Authorization: Bearer {{token}}

###

### Get character details by id (no stats)
GET {{baseUrl}}/api/character/1/details
Authorization: Bearer {{token}}

###

### Create a character
POST {{baseUrl}}/api/character
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Maeve",
    "level": 1
}

###

### Update a character
PUT {{baseUrl}}/api/character/2
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Derpsi",
    "level": 2,
    "isActive": false
}

###

### Update a character's notes (body is a raw JSON string)
PATCH {{baseUrl}}/api/character/2/notes
Authorization: Bearer {{token}}
Content-Type: application/json

"Met the Araka pirates at the docks."

###

### Delete a character
DELETE {{baseUrl}}/api/character/1
Authorization: Bearer {{token}}