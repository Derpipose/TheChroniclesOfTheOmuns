POST {{baseUrl}}/api/scifi/scifirace/{{arakaRaceId}}/subrace
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "subRaceName": "House Gears",
    "description": "",
    "raceStatsId": 0,
    "raceStats": {
        "modifiers": [],
        "freeStatPicks": []
    }
}

