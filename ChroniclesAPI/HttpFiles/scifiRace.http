@baseUrl = http://localhost:5237
@token = your-jwt-token-here
@scifiRaceId = 1

### Get all scifi races
GET {{baseUrl}}/api/scifi/scifirace
Authorization: Bearer {{token}}

###

### Get scifi race by id
GET {{baseUrl}}/api/scifi/scifirace/{{scifiRaceId}}
Authorization: Bearer {{token}}

###

### Create a scifi race (Divaren)
POST {{baseUrl}}/api/scifi/scifirace
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "subType": "Alien",
    "name": "Divaren",
    "description": "A short squat bearded race similar to humans.",
    "isStarterRace": true,
    "raceStatsId": 1,
    "speed": 30,
    "adventuringAgeStart": 18,
    "ageMax": 90
}

###

### Create a scifi race (non-starter race)
POST {{baseUrl}}/api/scifi/scifirace
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "subType": "Alien",
    "name": "Eel'a-Siek-Cha'za",
    "description": "Squid-like race that values science above all else.",
    "isStarterRace": false,
    "raceStatsId": 2,
    "speed": 30,
    "adventuringAgeStart": 20,
    "ageMax": 200
}

###

### Create a scifi race (Araka)
POST {{baseUrl}}/api/scifi/scifirace
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "subType": "Alien",
    "name": "Araka",
    "description": "The Araka are very war-like.",
    "isStarterRace": true,
    "raceStatsId": 3,
    "speed": 30,
    "adventuringAgeStart": 16,
    "ageMax": 80
}

###

### Create a scifi race (Quin-Val - fast-moving race)
POST {{baseUrl}}/api/scifi/scifirace
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "subType": "Alien",
    "name": "Quin-Val",
    "description": "A fast-moving race.",
    "isStarterRace": true,
    "raceStatsId": 4,
    "speed": 40,
    "adventuringAgeStart": 18,
    "ageMax": 100
}

