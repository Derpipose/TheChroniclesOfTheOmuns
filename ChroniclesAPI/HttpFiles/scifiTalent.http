@baseUrl = http://localhost:5237
@token = HaNope
@talentId = 2
@characterId = 1

### Get all talents
GET {{baseUrl}}/api/scifi/scifitalent
Authorization: Bearer {{token}}

###

### Get talent by id
GET {{baseUrl}}/api/scifi/scifitalent/{{talentId}}
Authorization: Bearer {{token}}

###

### Get the talent picks for a character (class talents are granted, pool talents are pickable)
GET {{baseUrl}}/api/scifi/scifitalent/TalentPicks/{{characterId}}
Authorization: Bearer {{token}}
